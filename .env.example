# LLM provider (OpenAI-compatible) — REQUIRED for the agent pipeline.
# Course submission uses LLMod.ai: set only LLMOD_API_KEY + LLMOD_BASE_URL
# (models default to MB5R2CF-azure/gpt-5.4-mini + text-embedding-3-small).
LLMOD_API_KEY=
LLMOD_BASE_URL=

# Optional dev override — any OpenAI-compatible provider, e.g. Gemini:
# LLMOD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=1536

# Supabase — REQUIRED from Phase 3 (storage & indexers)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Browser-side Supabase Auth (publishable/anon key — safe to expose; used
# only for the optional login system, never for table access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pinecone — REQUIRED from Phase 3 (vector search)
PINECONE_API_KEY=
PINECONE_INDEX=polymarkov

# Reddit (optional social source; leave blank to disable)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky / X — not used in this build (feature-flagged off)
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# X_BEARER_TOKEN=
