# LLMod.ai (OpenAI-compatible) — REQUIRED for the agent pipeline
LLMOD_API_KEY=
LLMOD_BASE_URL=

# Supabase — REQUIRED from Phase 3 (storage & indexers)
SUPABASE_URL=
