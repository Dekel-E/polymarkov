# LLM provider (OpenAI-compatible) — REQUIRED for the agent pipeline.
# Course submission uses LLMod.ai: set only LLMOD_API_KEY + LLMOD_BASE_URL
# (models default to MB5R2CF-azure/gpt-5.4-mini +
# MB5R2CF-azure/text-embedding-3-small).
LLMOD_API_KEY=
LLMOD_BASE_URL=
# Atomic across all web requests and jobs once migration 0017 is installed.
LLM_GLOBAL_DAILY_REQUEST_LIMIT=150

# Optional dev override — any OpenAI-compatible provider, e.g. Gemini:
# LLMOD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=1536

# Supabase — REQUIRED from Phase 3 (storage & indexers)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Pinecone — REQUIRED from Phase 3 (vector search)
PINECONE_API_KEY=
PINECONE_INDEX=polymarkov

# Reddit OAuth is optional. When blank, the agent uses keyless public search;
# setting both values enables the OAuth API for higher, more reliable limits.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky search is keyless and enabled in code. X remains disabled.
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# X_BEARER_TOKEN=
